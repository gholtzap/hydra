DEEPGRAM_API_KEY=

# Optional providers exposed in the Voice settings panel.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Optional local-provider defaults.
OLLAMA_MODEL=llama3.1
WHISPER_MODEL=base
